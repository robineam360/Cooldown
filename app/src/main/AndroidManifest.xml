<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CCRM-67 (Pin Service): the always-on notification's foreground service.
         FOREGROUND_SERVICE is the general grant every FGS needs since API 28;
         FOREGROUND_SERVICE_SPECIAL_USE is the type-specific grant API 34 added on
         top of it, required because the service declares
         foregroundServiceType="specialUse" below — none of the typed categories
         (location, media, health, …) describe a pinned usage readout. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- So the pin can restart itself after a reboot without the user having to
         reopen the app first. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sideload-only app (never Play Store): allowed to enumerate installed
         browsers so the sign-in "open with" picker can list them reliably,
         including on OEM skins where a scoped <queries> under-reports.
         Lint pushes for a scoped <queries> instead; that's the right advice for a
         Play Store app, where this permission needs a declared use case and can
         block a release. It doesn't apply here, and a scoped list is exactly what
         under-reports on the skins we care about. Suppressed deliberately —
         revisit if this app is ever published. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ClaudeUsage"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules">

        <!-- Handle size changes ourselves instead of being recreated. Compose
             relayouts on its own, and on a foldable the alternative is that every
             fold or unfold tears the activity down mid-refresh: the spinner and
             any error message live in remember{} state and would vanish with it.
             uiMode is deliberately absent — a day/night switch should still
             recreate, which is how the theme gets reapplied. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.PinnedRefreshReceiver"
            android:exported="false" />

        <!-- CCRM-67 (Pin Service): restarts the pin after a reboot, when it was on
             before the reboot. android:exported="true" because BOOT_COMPLETED is a
             protected broadcast — it's on the platform's protected-broadcast list,
             so no app but the system can ever send it — and an unexported receiver
             risks the system's own broadcast not being delivered at all. Exporting
             it isn't handing anything to other apps: there's nothing for a
             third-party BOOT_COMPLETED to spoof that the system doesn't already
             send for free on every boot. -->
        <receiver
            android:name=".notify.PinnedBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- CCRM-67 (Pin Service): the always-on notification's foreground service.
             specialUse (API 34+) is the FGS type — see the permission comment
             above for why — and PROPERTY_SPECIAL_USE_FGS_SUBTYPE is the short,
             honest description Play/Settings surfaces for it; there is no user
             flow through this app that isn't the one the subtype names.
             exported="false": nothing outside this app ever has a reason to bind
             to or start it directly, only PinnedNotification.update and the boot
             receiver, both in-process. -->
        <service
            android:name=".notify.PinnedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent usage-window readout the user turned on in Settings" />
        </service>

        <!-- CCRM-84 (Faces Gallery): the debug-only screen that inflates every face ×
             bucket × state, reached from Settings → Debug (wired by the seat). Not
             exported: nothing outside this app has a reason to open it. -->
        <activity
            android:name=".widgets.FacesGalleryActivity"
            android:exported="false"
            android:theme="@style/Theme.ClaudeUsage" />

        <!-- CCRM-78 (Widgets Reborn) §Config: placing and reconfiguring any of the four
             faces. Exported with the APPWIDGET_CONFIGURE filter because the launcher
             starts it; it finishes at once on an invalid id or one whose provider is not
             this package's, so no other app can use it to write a widget's prefs. -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClaudeUsage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- CCRM-78 §On-face controls and R7: Number 4×2's chips and cycler, and the one
             transition alarm. Not exported: the provider is exported for the launcher, so
             a custom action sent to it could come from any app. -->
        <receiver
            android:name=".widgets.WidgetActionReceiver"
            android:exported="false" />

        <!-- R7: redraw and re-arm on boot, update, clock and zone change. Exported so the
             system's own broadcasts reach it; BOOT_COMPLETED is protected, MY_PACKAGE_REPLACED
             is addressed to this package, and TIME_SET / TIMEZONE_CHANGED are on the
             implicit-broadcast exemption list — nothing another app can spoof. -->
        <receiver
            android:name=".widgets.WidgetSystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- CCRM-79 (Ring Face). R9: the class name is permanent. Exported for the launcher,
             which is why the on-face controls go to WidgetActionReceiver instead. -->
        <receiver
            android:name=".widgets.RingWidgetProvider"
            android:label="@string/widget_ring_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ring_widget_info" />
        </receiver>

        <!-- CCRM-80 (Number Face). R9: the class name is permanent. Exported for the launcher,
             which is why the on-face controls go to WidgetActionReceiver instead. -->
        <receiver
            android:name=".widgets.NumberWidgetProvider"
            android:label="@string/widget_number_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/number_widget_info" />
        </receiver>

        <!-- CCRM-81 (Countdown Face). R9: the class name is permanent. Exported for the launcher,
             which is why the on-face controls go to WidgetActionReceiver instead. -->
        <receiver
            android:name=".widgets.CountdownWidgetProvider"
            android:label="@string/widget_countdown_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!-- CCRM-82 (Accounts Strip). R9: the class name is permanent. Exported for the launcher,
             which is why the on-face controls go to WidgetActionReceiver instead. -->
        <receiver
            android:name=".widgets.StripWidgetProvider"
            android:label="@string/widget_strip_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/strip_widget_info" />
        </receiver>


    </application>
</manifest>
