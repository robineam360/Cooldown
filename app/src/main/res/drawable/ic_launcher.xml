<?xml version="1.0" encoding="utf-8"?>
<!-- Round in-app rendition of the launcher icon (About screen, fallbacks).
     CCRM-60 (Dual Identity): the same 108 grid as the adaptive layers - the charcoal
     plate and the whole Pulse S2 (Tall) trace in one file, same coordinates - so the
     About screen, the share card and the Play listing all pull from the same
     geometry as the launcher. Round 10, chosen 2026-09-10;
     design/app-icon-v2-wireframe.html symbol #r10s2.

     The clip is now the SAME SQUIRCLE THE LAUNCHER USES - the One UI curve inscribed
     in the visible 72 square, pathData verbatim from the round-10 section - not the
     round-7 r 50 disc. The disc was far more generous than any launcher mask and
     showed the trace's two end caps that the launcher always cuts; the squircle
     costs About those end caps and the outer ceiling dashes, and buys one picture
     being the icon everywhere. Samsung One UI's default is the squircle, which is
     what Robin's Fold 7 draws (research/2026-09-10-device-pass/launcher-icon-drawer.png). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <!-- The viewport is the visible 72 window, not the 108 layer: the adaptive layers keep
         their 18-unit parallax margin, but a bitmap-like in-app drawable has nothing to
         parallax, and keeping 108 would shrink the art to 0.72x inside its 48 dp box
         (About draws it at 56 dp; the squircle would have measured 37 dp of art). The
         group translates by -18 so every path below keeps the launcher's coordinates. -->
    <group
        android:translateX="-18"
        android:translateY="-18">
        <clip-path android:pathData="M54,18 C24.48,18 18,24.48 18,54 C18,83.52 24.48,90 54,90 C83.52,90 90,83.52 90,54 C90,24.48 83.52,18 54,18 Z" />
        <!-- the charcoal plate -->
        <path
            android:pathData="M0,0 H108 V108 H0 Z"
            android:fillColor="#1F1B19" />
        <!-- even-pace ceiling: cream, y 42 across x 12 -> 94, as seven butt-capped
             dashes (VectorDrawable has no stroke dashing) -->
        <path
            android:pathData="M12,42 h7 M24.5,42 h7 M37,42 h7 M49.5,42 h7 M62,42 h7 M74.5,42 h7 M87,42 h7"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#F3EBE3"
            android:strokeWidth="3.9"
            android:strokeAlpha="0.72"
            android:strokeLineCap="butt"
            android:strokeLineJoin="round" />
        <!-- P wave, Claude account -->
        <path
            android:pathData="M12,64 L27,64 L34,50 L41,64 L44,64"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#D97757"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- T wave, ChatGPT account -->
        <path
            android:pathData="M66,64 L71,64 L78,50 L85,64 L96,64"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#10A37F"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- QRS, the run past pace, drawn last so it owns both joins -->
        <path
            android:pathData="M44,64 L48,72 L54,20 L60,74 L66,64"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FF5252"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
