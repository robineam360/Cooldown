<?xml version="1.0" encoding="utf-8"?>
<!-- Round in-app rendition of the launcher icon (About screen, fallbacks).
     CCRM-101 (Icon v3): "Shared pace", chosen by Robin 2026-11-02, designed by ChatGPT; master
     design/icon-v3/shared-pace.svg. The same 108 grid as the adaptive layers - the plate and the whole mark
     in one file, same group transform, so the About screen, the share card and the Play listing pull from
     the same geometry as the launcher. The clip is the same One UI squircle the launcher uses, inscribed in
     the visible 72 square (pathData verbatim from the Pulse round). The mark fits the 66 dp safe circle, so
     the squircle cuts nothing of it.
     Geometry: design/icon-v3/shared-pace.svg, the #mark group, in the SVG's 100-unit space. All three arcs
     share one centre, (52, 50), solved from the path data (radii 33 / 24.5 / 16); the mark's bounding box
     (stroke half-widths included) is x 15.95-81.05, y 13.95-86.05, centred at (48.50, 50.00), which is NOT the
     arcs' centre because the C is open on the right. A <group> scales the mark by 0.81 and translates it so
     that bounding-box centre lands on (54, 54); the farthest point of the mark, round caps included, then
     sits 32.9 units from (54, 54), inside the 33-unit radius of the 66 dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <!-- The viewport is the visible 72 window, not the 108 layer: the adaptive layers keep their 18-unit
         parallax margin, but this drawable has nothing to parallax, and keeping 108 would shrink the art to
         0.72x. The outer group translates by -18 so every path below keeps the launcher's coordinates. -->
    <group
        android:translateX="-18"
        android:translateY="-18">
        <clip-path android:pathData="M54,18 C24.48,18 18,24.48 18,54 C18,83.52 24.48,90 54,90 C83.52,90 90,83.52 90,54 C90,24.48 83.52,18 54,18 Z" />
        <!-- the plate -->
        <path
            android:pathData="M0,0 H108 V108 H0 Z"
            android:fillColor="#1F1B19" />
    <group
            android:translateX="14.7131"
            android:translateY="13.4999"
            android:scaleX="0.81"
            android:scaleY="0.81">
            <!-- track -->
            <path
                android:pathData="M 76.1347,72.5059 A 33,33 0 1,1 78.0044,29.6832"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#524944"
                android:strokeWidth="2.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- track -->
            <path
                android:pathData="M 69.9182,66.7090 A 24.5,24.5 0 1,1 71.3063,34.9163"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#524944"
                android:strokeWidth="2.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- track -->
            <path
                android:pathData="M 63.7017,60.9120 A 16,16 0 1,1 64.6082,40.1494"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#524944"
                android:strokeWidth="2.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- Claude arc, terracotta, up to the pace line -->
            <path
                android:pathData="M 76.1347,72.5059 A 33,33 0 1,1 69.9731,22.3239"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#D97757"
                android:strokeWidth="6.1"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- over-pace segment of the Claude arc, red -->
            <path
                android:pathData="M 69.9731,22.3239 A 33,33 0 0,1 78.0044,29.6832"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#FF5252"
                android:strokeWidth="6.1"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- ChatGPT arc, meets the line -->
            <path
                android:pathData="M 69.9182,66.7090 A 24.5,24.5 0 1,1 65.3437,29.4526"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#19C39A"
                android:strokeWidth="6.1"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- Gemini arc, stops short of the line -->
            <path
                android:pathData="M 63.7017,60.9120 A 16,16 0 1,1 50.0501,34.1193"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#8AB4F8"
                android:strokeWidth="6.1"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- plate-coloured halo under the pace line -->
            <path
                android:pathData="M 58.5357,39.9360 L 72.1516,18.9692"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#1F1B19"
                android:strokeWidth="6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- pace line, red -->
            <path
                android:pathData="M 58.5357,39.9360 L 72.1516,18.9692"
                android:fillColor="@android:color/transparent"
                android:strokeColor="#FF5252"
                android:strokeWidth="3.3"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
