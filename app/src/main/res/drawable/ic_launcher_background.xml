<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-60 (Dual Identity): the adaptive icon's background layer. Pulse, variant S2
     (Tall) on the charcoal plate - chosen 2026-09-10, round 10 of
     design/app-icon-v2-wireframe.html. The plate is one flat 108 x 108 path filled
     charcoal #1F1B19: no gradient, no radial, nothing else in this layer. The
     round-7 two-colour ground (terracotta over green) and the CCRM-56 (Provider
     Identity) slate radial both retire here; the two accounts are now carried by
     the trace's own colour roles in ic_launcher_foreground.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 H108 V108 H0 Z"
        android:fillColor="#1F1B19" />
</vector>
