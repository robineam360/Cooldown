<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-60 (Dual Identity): themed-icon layer. Same Pulse S2 (Tall) geometry as
     ic_launcher_foreground.xml with colour removed - round 10, chosen 2026-09-10,
     design/app-icon-v2-wireframe.html symbol #r10s2.

     Exactly TWO paths, per that wireframe's implementer note: the whole trace as one
     polyline at full strokeAlpha, and the ceiling as a second path at 0.55. The
     terracotta, red and green runs share their endpoints, so joining them costs
     nothing - they become one continuous polyline from (12,64) to (96,64). The two
     accounts are deliberately NOT carried here as three alpha grades: the launcher
     tints this layer as one colour and the grades stop reading, so what has to
     survive is shape - the P and T bumps and the Q/S dips either side of the apex -
     not tone. This is round 9's decision 4, and the round-10 tiles preview the
     themed layer this way ("one tint, as built"). No gradients and no fills, so
     nothing thins out under tint and downscale; the ceiling's dashes are short
     subpaths because VectorDrawable has no stroke dashing, with butt caps so the
     dash pitch is exactly the SVG's. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- even-pace ceiling: y 42 across x 12 -> 94, seven butt-capped dashes, 0.55 -->
    <path
        android:pathData="M12,42 h7 M24.5,42 h7 M37,42 h7 M49.5,42 h7 M62,42 h7 M74.5,42 h7 M87,42 h7"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.9"
        android:strokeAlpha="0.55"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />
    <!-- the whole trace, P-QRS-T as one polyline, solid -->
    <path
        android:pathData="M12,64 L27,64 L34,50 L41,64 L44,64 L48,72 L54,20 L60,74 L66,64 L71,64 L78,50 L85,64 L96,64"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeAlpha="1.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
