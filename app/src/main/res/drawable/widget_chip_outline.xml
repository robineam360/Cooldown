<?xml version="1.0" encoding="utf-8"?>
<!-- Number 4×2's unselected window chip: a 1 dp outline, tinted to 28% ink at render time.
     The transparent solid is load-bearing: a GradientDrawable with a colour filter and no
     solid of its own paints its interior with the filter colour (seen at Step 4). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF" />
    <corners android:radius="12dp" />
</shape>
