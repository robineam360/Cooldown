<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed row for the "big number" pinned-notification style. Sits inside
    DecoratedCustomViewStyle, so the system still draws the icon/app-name chrome
    and we only own this strip. The number is kept at 32sp deliberately: the
    collapsed content area is short, and anything taller starts clipping on some
    OEM skins.

    The number sits on the RIGHT to line up with the other styles, where the
    percentage lands in the large-icon slot that the shade renders trailing.

    Text colours come from the platform's own notification appearances, never
    from ?android:attr/textColorPrimary: that resolves against Theme.ClaudeUsage
    (light in values/, dark in values-night/), not against the shade, which
    produced dark text on a dark shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- CCRM-103 (Hybrid Notification), shape grammar rev D §3 N1: the 5h as a 44 dp ring
         on the left, 14 dp from the column, its figure (no label) centred in the bore at
         0.29 of the ring, fitted at runtime. Gone for a plan with no 5h (B1: today's row
         exactly). 44 dp sits inside the ~53 dp row, so the collapsed height does not grow. -->
    <FrameLayout
        android:id="@+id/ring_box"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ring_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/ring_fig"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFeatureSettings="tnum,lnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CCRM-56 (Provider Identity): the mark rides the label line. -->
            <ImageView
                android:id="@+id/provider_mark"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/title"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- CCRM-15 (Above-Pace Verification), wireframe rev E §9c: while the
                 synthetic series is on, this dot stands in for the band the collapsed
                 row has no height for. After the weight-1 title, so it ends the row
                 beside the figure. TalkBack reads it in flow; gone, it is silent. -->
            <ImageView
                android:id="@+id/synth_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/notif_synth_dot"
                android:visibility="gone"
                android:contentDescription="Synthetic data"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginTop="3dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sub"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- CCRM-22 (Used or Left): in Left mode the number is the remainder and the
         small caption below says so; Used mode keeps the caption gone. CCRM-103: the
         figure is always the Weekly, tabular and lining, its "%" at 58% (set in code). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/pct"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFeatureSettings="tnum,lnum"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/pct_caption"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:text="LEFT"
            android:visibility="gone"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
