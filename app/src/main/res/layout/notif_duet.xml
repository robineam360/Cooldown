<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed row for the Duet — the always-on notification carrying two accounts — in the
    stacked layout of CCRM-105 (Duet Stack), design/2026-11-10-v20-feedback-wireframes.html §1
    (rev B, approved 2026-11-10). Only rendered when a Second account is set; with Second =
    None the notification keeps notif_big_number.xml.

    52 dp high, as the halves were. Left to right: First's 5h ring (36) · 6 · Second's (36) ·
    8 · two stacked rows · each row's figure in a fixed 42 dp slot, 8 dp after its bar. The
    chrome is 136 dp; the bars take the rest, and both share one left edge and one length.
    Each row is 24 dp: the name line (mark 14, 4, name 12 sp, the state word 11 sp at the
    right), 1 dp, the 8 dp Weekly bar; rows 2 dp apart, 1 dp padding top and bottom.

    Narrow drop order (one order everywhere): the bar absorbs (weight), the name ellipsizes
    to its 24 dp floor, then the state word drops its tail ("Held · 3:40 PM" → "Held"), which
    code decides (Duet.keepsTail) since a RemoteViews cannot measure. Rings and the figure
    slot never shrink. The collapsed text is sized in dp from code, capped (Duet.*_CAP_DP).

    Text colours come from the platform's own notification appearances, never from
    ?android:attr/textColorPrimary: that resolves against Theme.ClaudeUsage, not the shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <!-- First's 5h ring: tap opens First. -->
    <FrameLayout
        android:id="@+id/duet_ring_box_first"
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/duet_ring_first"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/duet_ring_fig_first"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFeatureSettings="tnum,lnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Second's 5h ring: tap opens Second. -->
    <FrameLayout
        android:id="@+id/duet_ring_box_second"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/duet_ring_second"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/duet_ring_fig_second"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFeatureSettings="tnum,lnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <!-- First's row: its own tap target, as its ring is. -->
        <LinearLayout
            android:id="@+id/duet_half_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The name line: the state word pinned to the right, the mark, name and dot
                     in the space left of it. Code pads the line's end by the word's width
                     (Duet.wordDp), so the name ellipsizes before the word rather than under it;
                     the name gives way first (its weight inside the wrap_content line), and a
                     short name keeps its dot beside it. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="15dp">

                    <TextView
                        android:id="@+id/duet_word_first"
                        style="@android:style/TextAppearance.Material.Notification.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:paddingStart="6dp"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/duet_line_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/duet_mark_first"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/duet_label_first"
                            style="@android:style/TextAppearance.Material.Notification.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/duet_dot_first"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/notif_condition_dot"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                        <!-- CCRM-15 (Above-Pace Verification), rev E §9c: the synthetic
                             marker, app-global, so First only. -->
                        <ImageView
                            android:id="@+id/duet_synth_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/notif_synth_dot"
                            android:visibility="gone"
                            android:contentDescription="Synthetic data"
                            android:importantForAccessibility="yes" />
                    </LinearLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/duet_bar_first"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="1dp"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- The Weekly figure, right-aligned in its fixed 42 dp slot; no caption collapsed. -->
            <TextView
                android:id="@+id/duet_pct_first"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end|center_vertical"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFeatureSettings="tnum,lnum"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Second's row: its own tap target, as its ring is. -->
        <LinearLayout
            android:id="@+id/duet_half_second"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The name line: the state word pinned to the right, the mark, name and dot
                     in the space left of it. Code pads the line's end by the word's width
                     (Duet.wordDp), so the name ellipsizes before the word rather than under it;
                     the name gives way first (its weight inside the wrap_content line), and a
                     short name keeps its dot beside it. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="15dp">

                    <TextView
                        android:id="@+id/duet_word_second"
                        style="@android:style/TextAppearance.Material.Notification.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:paddingStart="6dp"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/duet_line_second"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/duet_mark_second"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/duet_label_second"
                            style="@android:style/TextAppearance.Material.Notification.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/duet_dot_second"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/notif_condition_dot"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/duet_bar_second"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="1dp"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- The Weekly figure, right-aligned in its fixed 42 dp slot; no caption collapsed. -->
            <TextView
                android:id="@+id/duet_pct_second"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end|center_vertical"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFeatureSettings="tnum,lnum"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
