                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
