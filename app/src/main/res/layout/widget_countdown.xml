<?xml version="1.0" encoding="utf-8"?>
<!--
    CCRM-81 (Countdown Face): caption, the live chronometer or an absolute time, and on
    2×2 the figure row over a 6 dp bar; the account line at the bottom.

    GENERATED by tools/widget_layouts.py — the three files of this face (base, _sd, _sl) differ only in the text
    style: WFace, WFace.ShadowDark or WFace.ShadowLight (a Transparent face's soft shadow
    in the opposite tone, rev D). WidgetLayoutsTest fails if they drift. Only views
    RemoteViews allows appear here; spacers are empty FrameLayouts, never <View>.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/w_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_wash"
        android:visibility="gone"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_ribbon"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#FF7C4DFF"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="● SYNTHETIC"
            android:textColor="#FFFFFFFF"
            android:textSize="6.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/w_pad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/cd_col"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/cd_caption"
                    style="@style/WFace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:singleLine="true" />
                <LinearLayout
                    android:id="@+id/cd_countrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true"
                    android:layout_marginTop="2dp">
                    <Chronometer
                        android:id="@+id/cd_chrono"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/cd_abs"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/cd_at_inline"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:id="@+id/cd_at_below"
                    style="@style/WFace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="3dp"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/cd_msg"
                    style="@style/WFace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:includeFontPadding="false" />
                <FrameLayout
                    android:id="@+id/cd_gap1"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/cd_figrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="bottom">
                    <TextView
                        android:id="@+id/cd_fig"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/cd_leftcap"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:text="LEFT"
                        android:visibility="gone"
                        android:layout_marginStart="4dp"
                        android:letterSpacing="0.08" />
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/cd_est"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:singleLine="true" />
                </LinearLayout>
                <TextView
                    android:id="@+id/cd_est_below"
                    style="@style/WFace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="2dp"
                    android:singleLine="true" />
                <ImageView
                    android:id="@+id/cd_bar"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    android:layout_marginTop="2dp"
                    android:scaleType="fitXY" />
                <FrameLayout
                    android:id="@+id/cd_gap2"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/cd_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/cd_mark"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/cd_label"
                            style="@style/WFace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:ellipsize="end" />
                        <ImageView
                            android:id="@+id/cd_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/notif_condition_dot"
                            android:visibility="gone"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/cd_stamp"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:visibility="gone"
                        android:layout_marginStart="6dp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
        android:id="@+id/w_msg"
        style="@style/WFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textSize="11.5sp"
        android:visibility="gone"
        android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_synth_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_synth_dot"
        android:visibility="gone"
        android:layout_gravity="top|end"
        android:layout_margin="5dp" />
</FrameLayout>
