<?xml version="1.0" encoding="utf-8"?>
<!--
    CCRM-80 (Number Face): label and figure on one row, the bar under both, the absolute
    sub-line from 4×1, and the 4×2 control row (window chips, account cycler).

    GENERATED by tools/widget_layouts.py — the three files of this face (base, _sd, _sl) differ only in the text
    style: WFace, WFace.ShadowDark or WFace.ShadowLight (a Transparent face's soft shadow
    in the opposite tone, rev D). WidgetLayoutsTest fails if they drift. Only views
    RemoteViews allows appear here; spacers are empty FrameLayouts, never <View>.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/w_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_wash"
        android:visibility="gone"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_ribbon"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#FF7C4DFF"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="● SYNTHETIC"
            android:textColor="#FFFFFFFF"
            android:textSize="6.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/w_pad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/num_col"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/num_reading"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:paddingBottom="3dp">
                            <TextView
                                android:id="@+id/num_pill"
                                style="@style/WFace.ShadowDark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:text="UNASSIGNED"
                                android:visibility="gone"
                                android:layout_marginStart="18dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:background="@drawable/widget_pill"
                                android:letterSpacing="0.05" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <ImageView
                                    android:id="@+id/num_mark"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:importantForAccessibility="no"
                                    android:layout_marginEnd="4dp" />
                                <TextView
                                    android:id="@+id/num_label"
                                    style="@style/WFace.ShadowDark"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:singleLine="true"
                                    android:ellipsize="end" />
                                <ImageView
                                    android:id="@+id/num_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/notif_condition_dot"
                                    android:visibility="gone"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/num_weekly2"
                                style="@style/WFace.ShadowDark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:text="Weekly"
                                android:visibility="gone"
                                android:layout_marginStart="18dp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/num_fig"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp"
                            android:includeFontPadding="false"
                            android:singleLine="true" />
                        <TextView
                            android:id="@+id/num_leftcap"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:text="LEFT"
                            android:visibility="gone"
                            android:layout_marginStart="4dp"
                            android:letterSpacing="0.08" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/num_bar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:layout_marginTop="1dp"
                        android:scaleType="fitXY" />
                    <LinearLayout
                        android:id="@+id/num_subrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:gravity="bottom"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/num_sub"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/num_stamp"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:visibility="gone"
                            android:includeFontPadding="false"
                            android:layout_marginStart="8dp"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/num_ctrl"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="center_vertical">
                    <FrameLayout
                        android:id="@+id/num_chip_s"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/num_chip_s_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_chip"
                            android:scaleType="fitXY" />
                        <TextView
                            android:id="@+id/num_chip_s_text"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/num_chip_w"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/num_chip_w_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_chip"
                            android:scaleType="fitXY" />
                        <TextView
                            android:id="@+id/num_chip_w_text"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/num_chip_fixed"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/num_chip_fixed_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_chip"
                            android:scaleType="fitXY" />
                        <TextView
                            android:id="@+id/num_chip_fixed_text"
                            style="@style/WFace.ShadowDark"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <FrameLayout
                        android:id="@+id/num_cycler"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp">
                        <ImageView
                            android:id="@+id/num_cycler_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_chip"
                            android:scaleType="fitXY" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/num_cycler_mark"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:importantForAccessibility="no"
                                android:layout_marginEnd="5dp" />
                            <TextView
                                android:id="@+id/num_cycler_text"
                                style="@style/WFace.ShadowDark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:singleLine="true" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
        android:id="@+id/w_msg"
        style="@style/WFace.ShadowDark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textSize="11.5sp"
        android:visibility="gone"
        android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_synth_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_synth_dot"
        android:visibility="gone"
        android:layout_gravity="top|end"
        android:layout_margin="5dp" />
</FrameLayout>
