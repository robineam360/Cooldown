<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): the Countdown face's picker preview (previewLayout) — a static
     Solid, dark, S1 face, redrawn for CCRM-103 (Hybrid Notification)'s shape grammar (rev D
     §5, Fable C6): the 5h ring in place of the "5h reset" caption, then the count, "at 9:10 PM"
     on its own line and the account. One UI lays a preview out at ~110 × 76 dp, so the ring
     and the count share the width (2 : 3) and the count auto-sizes, rather than the time
     ellipsizing (CCBG-40 (Picker Preview Ellipsis)). Free to change later (R9); never
     inflated for a placed widget, which always draws through WidgetFace.render. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1A1A1A" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <!-- CCBG-96 (Picker Preview Truncation): ring 1 : count 2, the live 2×1 face's proportion, so "at 9:10 PM" fits
             (design/2026-11-12-step3-fix-wireframes.html §1 A, approved 2026-11-12). -->
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_ring_5h" android:importantForAccessibility="no" />
            <TextView style="@style/WFace" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="16dp" android:paddingBottom="16dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="38%" android:textColor="#FFEDE8E4" android:textStyle="bold"
                android:fontFeatureSettings="tnum,lnum"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView style="@style/WFace" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="bottom|start" android:includeFontPadding="false" android:maxLines="1"
                android:text="2:41:07" android:textColor="#FFEDE8E4" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="at 9:10 PM" android:textSize="11sp" android:textColor="#BFEDE8E4" android:layout_marginTop="2dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="Pro" android:textSize="11sp" android:textColor="#FFEDE8E4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
