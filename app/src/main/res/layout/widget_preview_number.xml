<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): the Number face's picker preview (previewLayout, wireframe
     rev D §7) — a static Solid, dark, S1 face. Free to change later (R9); never inflated
     for a placed widget, which always draws through WidgetFace.render. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1A1A1A" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="6dp" />
            <TextView style="@style/WFace" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true"
                android:text="Pro · 5h" android:textSize="13sp" android:textColor="#FFEDE8E4" />
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="38%" android:textSize="32sp" android:textColor="#FFE59980" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:src="@drawable/widget_preview_number_bar"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView style="@style/WFace" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true"
                android:text="Resets 9:10 PM" android:textSize="12sp" android:textColor="#C7EDE8E4" />
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="as of 6:29 PM" android:textSize="10sp" android:textColor="#8CEDE8E4" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
