<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): the Number face's picker preview (previewLayout) — a static
     Solid, dark, S1 face, redrawn for CCRM-103 (Hybrid Notification)'s shape grammar (rev D
     §5's 4×1, Fable C6): the 5h ring at the left of the Weekly name, figure and bar, then the
     reset and the stamp. Free to change later (R9); never inflated for a placed widget, which
     always draws through WidgetFace.render. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1A1A1A" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <!-- The ring is as tall as the box leaves (rev D: Ø60 at 4×1), and square. -->
        <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:layout_marginEnd="12dp">
            <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:maxWidth="96dp" android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_ring_5h" android:importantForAccessibility="no" />
            <TextView style="@style/WFace" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="38%" android:textColor="#FFEDE8E4" android:textStyle="bold"
                android:fontFeatureSettings="tnum,lnum"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
                <TextView style="@style/WFace" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                    android:text="Pro" android:textSize="13sp" android:textColor="#FFEDE8E4" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="20%" android:textSize="32sp" android:textColor="#FFE59980" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum" android:layout_marginStart="10dp" />
            </LinearLayout>
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:src="@drawable/widget_preview_bar_weekly"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="2dp">
                <TextView style="@style/WFace" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                    android:text="Resets Sat 9:10 PM" android:textSize="12sp" android:textColor="#C7EDE8E4" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="as of 6:29 PM" android:textSize="10sp" android:textColor="#8CEDE8E4" android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
