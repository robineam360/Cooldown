<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): the Ring face's picker preview (previewLayout) — a static
     Solid, dark, S1 face, redrawn for CCRM-103 (Hybrid Notification)'s shape grammar (rev D
     §5, Fable C6): the 5h ring, the name, and the Weekly row under it. Free to change later
     (R9); never inflated for a placed widget, which always draws through WidgetFace.render. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1A1A1A" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="12dp">
        <!-- Rev F (CCBG-38 (Cover Buckets)): the ring takes whatever height the picker's
             preview box leaves above its lines, so a narrow or short box never clips it. -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_ring_5h" android:importantForAccessibility="no" />
            <!-- The figure auto-sizes inside the bore, in ink: 26 sp at most, smaller in a short box. -->
            <TextView style="@style/WFace" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="22dp" android:paddingBottom="22dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="38%" android:textColor="#FFEDE8E4" android:textStyle="bold"
                android:fontFeatureSettings="tnum,lnum"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="Pro" android:textSize="13sp" android:textColor="#FFEDE8E4" />
        </LinearLayout>
        <!-- The Weekly row (rev D's `awRing22`): "Weekly" at 78% ink, the bar, the figure in its bar colour. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="Weekly" android:textSize="11sp" android:textColor="#C7EDE8E4" />
            <ImageView android:layout_width="0dp" android:layout_weight="1" android:layout_height="9.6dp"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_bar_row" android:importantForAccessibility="no" />
            <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="20%" android:textSize="13sp" android:textColor="#FFE59980" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
