<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): the Accounts Strip face's picker preview (previewLayout) — a
     static Solid, dark, S1 face, redrawn for CCRM-103 (Hybrid Notification)'s shape grammar
     (rev D §5's 4×1, Fable C6): each account a 5h ring over its Weekly bar, then the name;
     ChatGPT (no 5h, B1) its Weekly figure in the ring's place. Free to change later (R9);
     never inflated for a placed widget, which always draws through WidgetFace.render. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1A1A1A" />
    <!-- Rev F (CCBG-38 (Cover Buckets)): each ring takes the height its bar and label leave,
         so a short picker box shrinks the rings instead of cutting the labels. -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"
                    android:src="@drawable/widget_preview_ring_5h_strip_a" android:importantForAccessibility="no" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="38%" android:textSize="11sp" android:textColor="#FFEDE8E4" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum" android:layout_gravity="center" />
            </FrameLayout>
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:src="@drawable/widget_preview_bar_strip" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="Pro" android:textSize="10sp" android:textColor="#FFEDE8E4" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"
                    android:src="@drawable/widget_preview_ring_5h_strip_b" android:importantForAccessibility="no" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="62%" android:textSize="11sp" android:textColor="#FFEDE8E4" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum" android:layout_gravity="center" />
            </FrameLayout>
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:src="@drawable/widget_preview_bar_strip" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_provider_claude" android:tint="#FFE59980" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="Work" android:textSize="10sp" android:textColor="#FFEDE8E4" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_horizontal">
            <!-- B1: no 5h, so the Weekly figure (in its bar colour) stands where the ring would be. -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="20%" android:textSize="16sp" android:textColor="#FF19C39A" android:textStyle="bold" android:fontFeatureSettings="tnum,lnum" android:layout_gravity="center" />
            </FrameLayout>
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:src="@drawable/widget_preview_bar_strip_gpt" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_provider_chatgpt" android:tint="#FF19C39A" android:importantForAccessibility="no" android:layout_marginEnd="3dp" />
                <TextView style="@style/WFace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:text="ChatGPT" android:textSize="10sp" android:textColor="#FFEDE8E4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
