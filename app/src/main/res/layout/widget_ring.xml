<?xml version="1.0" encoding="utf-8"?>
<!--
    CCRM-79 (Ring Face): the rails ring (a RingRenderer TICK bitmap) with the figure in
    its bore as real text; on 2×2 a label line under it.

    GENERATED by tools/widget_layouts.py — the three files of this face (base, _sd, _sl) differ only in the text
    style: WFace, WFace.ShadowDark or WFace.ShadowLight (a Transparent face's soft shadow
    in the opposite tone, rev D). WidgetLayoutsTest fails if they drift. Only views
    RemoteViews allows appear here; spacers are empty FrameLayouts, never <View>.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/w_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_wash"
        android:visibility="gone"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_ribbon"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#FF7C4DFF"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="● SYNTHETIC"
            android:textColor="#FFFFFFFF"
            android:textSize="6.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/w_pad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/ring_col"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:id="@+id/ring_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ring"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/ring_fig"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:includeFontPadding="false" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/ring_label_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <ImageView
                        android:id="@+id/ring_mark"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/ring_label"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <ImageView
                        android:id="@+id/ring_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/notif_condition_dot"
                        android:visibility="gone"
                        android:layout_marginStart="4dp" />
                    <TextView
                        android:id="@+id/ring_stamp"
                        style="@style/WFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:visibility="gone"
                        android:layout_marginStart="6dp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_corner_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/notif_condition_dot"
                android:visibility="gone"
                android:layout_gravity="top|end" />

            <TextView
        android:id="@+id/w_msg"
        style="@style/WFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textSize="11.5sp"
        android:visibility="gone"
        android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_synth_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_synth_dot"
        android:visibility="gone"
        android:layout_gravity="top|end"
        android:layout_margin="5dp" />
</FrameLayout>
