<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-78 (Widgets Reborn): free to change after release (R9) — only the provider's class
     name and the widget_prefs keys are permanent. updatePeriodMillis is 0 (R7: no periodic
     redraw; Surfaces.refresh, the provider callbacks and the one transition alarm do it).
     No configuration_optional (CCBG-43 (Widget Settings Hidden)): One UI took it as leave to
     skip the config on add, so every widget came up unassigned (R5) with no visible way out. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_number_description"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:previewLayout="@layout/widget_preview_number"
    android:initialLayout="@layout/widget_initial"
    android:configure="com.robin.claudeusage.widgets.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
