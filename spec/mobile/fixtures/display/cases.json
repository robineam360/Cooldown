{
  "_meta": {
    "note": "Usage display figures and the pace-mark caption (BEHAVIOR-MOBILE section 5, CCRM-100 (Vs Pace Display), CCRM-97 (Pace Number); wireframes design/2026-11-02-vs-pace-display.html and -pace-line-label.html V1). Spec-first, written 2026-11-02 by script from the rules, not ported from code. usedPct null = no reading; elapsedPct is core section 6's elapsedPercent; hasResetClock false = the window has not started. The minus sign is U+2212 and the middle dot U+00B7. A null expected caption means none is drawn. captionSide: the caption starts 5 dp right of the mark when it fits inside the bar width, else it ends 5 dp left of the mark."
  },
  "vsPaceFigure": [
    {
      "name": "under the mark",
      "usedPct": 50,
      "elapsedPct": 60,
      "hasResetClock": true,
      "expected": "+10%",
      "why": "floor(60 - 50) = +10"
    },
    {
      "name": "over the mark",
      "usedPct": 80,
      "elapsedPct": 60,
      "hasResetClock": true,
      "expected": "−20%",
      "why": "floor(60 - 80) = -20, printed with U+2212"
    },
    {
      "name": "rounded down: room is never overstated",
      "usedPct": 50.4,
      "elapsedPct": 60.9,
      "hasResetClock": true,
      "expected": "+10%",
      "why": "floor(10.5) = 10"
    },
    {
      "name": "rounded down over the mark",
      "usedPct": 60.2,
      "elapsedPct": 60.0,
      "hasResetClock": true,
      "expected": "−1%",
      "why": "floor(-0.2) = -1"
    },
    {
      "name": "exactly on the mark",
      "usedPct": 42,
      "elapsedPct": 42,
      "hasResetClock": true,
      "expected": "0%",
      "why": "no sign on zero"
    },
    {
      "name": "first hours of a window",
      "usedPct": 0.4,
      "elapsedPct": 1.7,
      "hasResetClock": true,
      "expected": "+1%",
      "why": "floor(1.3) = 1"
    },
    {
      "name": "week spent falls back to usage",
      "usedPct": 100,
      "elapsedPct": 89.8,
      "hasResetClock": true,
      "expected": "100%",
      "why": "the usage figure, as Used mode"
    },
    {
      "name": "spent threshold 99.5",
      "usedPct": 99.6,
      "elapsedPct": 95.0,
      "hasResetClock": true,
      "expected": "99%",
      "why": "usedPct >= 99.5 is spent: the usage figure, truncated as Used mode"
    },
    {
      "name": "no reset clock falls back to usage",
      "usedPct": 0,
      "elapsedPct": null,
      "hasResetClock": false,
      "expected": "0%",
      "why": "window not started: no pace mark"
    },
    {
      "name": "no reading",
      "usedPct": null,
      "elapsedPct": 50,
      "hasResetClock": true,
      "expected": "—",
      "why": "an em dash, as every mode"
    },
    {
      "name": "binary float edge: 2.3 - 0.3",
      "usedPct": 0.3,
      "elapsedPct": 2.3,
      "hasResetClock": true,
      "expected": "+2%",
      "why": "2.3 - 0.3 is 1.9999999999999998 in binary floats; floor after adding 1e-9 gives +2"
    },
    {
      "name": "binary float edge on the mark",
      "usedPct": 17.000000000000004,
      "elapsedPct": 17.0,
      "hasResetClock": true,
      "expected": "0%",
      "why": "(1 - 0.83) x 100 against an even 17: 0%, not -1%"
    }
  ],
